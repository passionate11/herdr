+/// Cards sit a small step from the host terminal background toward its foreground,
+/// so they stay subtle on any terminal theme; the focused agent's card is a step brighter.
+fn agent_card_bg(app: &AppState, active: bool) -> Color {
+    let theme = app.host_terminal_theme;
+    match (theme.background, theme.foreground) {
+        (Some(background), Some(foreground)) => {
+            let (r, g, b) = super::panes::mix_rgb(
+                super::panes::terminal_theme_to_rgb(background),
+                super::panes::terminal_theme_to_rgb(foreground),
+                if active { 0.09 } else { 0.035 },
+            );
+            Color::Rgb(r, g, b)
+        }
+        _ if active => app.palette.surface1,
+        _ => app.palette.surface0,
+    }
+}
+
+/// The box title already names the space, so rows drop the workspace token
+/// unless it is the only text left on the row.
+fn without_boxed_workspace(rows: Vec<Vec<ResolvedToken>>) -> Vec<Vec<ResolvedToken>> {
+    rows.into_iter()
+        .map(|row| {
+            let has_other_text = row.iter().any(|token| {
+                !matches!(
+                    token,
+                    ResolvedToken::StateIcon | ResolvedToken::Workspace(_)
+                )
+            });
+            if has_other_text {
+                row.into_iter()
+                    .filter(|token| !matches!(token, ResolvedToken::Workspace(_)))
+                    .collect()
+            } else {
+                row
+            }
+        })
+        .collect()
+}
+
+fn render_agent_group_box(frame: &mut Frame, group: &AgentGroupBox, active: bool, p: &Palette) {
+    let rect = group.rect;
+    if rect.width < 2 || rect.height < 2 {
+        return;
+    }
+
+    let border_style = Style::default().fg(if active { p.accent } else { p.overlay0 });
+    let title_style = if active {
+        Style::default().fg(p.accent).add_modifier(Modifier::BOLD)
+    } else {
+        Style::default().fg(p.subtext0).add_modifier(Modifier::BOLD)
+    };
+    let inner_width = (rect.width - 2) as usize;
+
+    let mut top = vec![Span::styled("╭", border_style)];
+    let mut used = 0;
+    // "─ " before the title and " " after it.
+    let title_budget = inner_width.saturating_sub(3);
+    if title_budget > 0 && !group.label.is_empty() {
+        let title = truncate_end(&group.label, title_budget);
+        used = display_width(&title) + 3;
+        top.push(Span::styled("─ ", border_style));
+        top.push(Span::styled(title, title_style));
+        top.push(Span::styled(" ", border_style));
+    }
+    top.push(Span::styled(
+        "─".repeat(inner_width.saturating_sub(used)),
+        border_style,
+    ));
+    top.push(Span::styled("╮", border_style));
+    frame.render_widget(
+        Paragraph::new(Line::from(top)),
+        Rect::new(rect.x, rect.y, rect.width, 1),
+    );
+
+    let bottom_y = rect.y + rect.height - 1;
+    for y in rect.y + 1..bottom_y {
+        for x in [rect.x, rect.x + rect.width - 1] {
+            frame.render_widget(
+                Paragraph::new(Span::styled("│", border_style)),
+                Rect::new(x, y, 1, 1),
+            );
+        }
+    }
+    frame.render_widget(
+        Paragraph::new(Span::styled(
+            format!("╰{}╯", "─".repeat(inner_width)),
+            border_style,
+        )),
+        Rect::new(rect.x, bottom_y, rect.width, 1),
+    );
+}
